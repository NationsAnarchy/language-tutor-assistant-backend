# Shared frontend/backend JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Temporary migration fallback only; prefer AUTH_SECRET.
# NEXTAUTH_SECRET=

GEMINI_API_KEY=
GOOGLE_EMBEDDING_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=language-tutor

# Explicit browser origins that may access FastAPI directly (usually only local dev).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# RAILWAY_VOLUME_PATH=/data
